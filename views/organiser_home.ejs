<%- include('head') %>
<body class="organiser-home-page">
<%- include('nav') %>

<section class="page-header">
    <div class="container">
        <p class="eyebrow">PulsePoint Studio Dashboard</p>
        <h1 class="page-title">Organiser Home Page</h1>
        <p class="page-lead"><%= siteSettings && siteSettings.name ? siteSettings.name : 'PulsePoint Wellness' %></p>
        <p class="page-lead"><%= siteSettings && siteSettings.description ? siteSettings.description : 'Flexible event management for organizers and attendees' %></p>
        <p class="login-note header-login-note"><strong>Last login:</strong> <%= currentUser && currentUser.lastLogin ? currentUser.lastLogin : 'This is your first login' %></p>
    </div>
</section>

<section class="section section--soft">
    <div class="container">
        <div class="organiser-command-centre">
            <div class="organiser-command-head">
                <div>
                    <p class="eyebrow">Live studio overview</p>
                    <h2>Today at a glance</h2>
                </div>
                <div class="dashboard-live-state"><span aria-hidden="true"></span> Dashboard ready</div>
            </div>

            <div class="organiser-layout">
                <aside class="kpi-panel">
                <div class="kpi-grid">
                    <div class="kpi-tile kpi-tile--published">
                        <small>01</small>
                        <span>Published</span>
                        <strong data-counter="<%= events.filter(e => e.status === 'published').length %>">0</strong>
                    </div>
                    <div class="kpi-tile kpi-tile--drafts">
                        <small>02</small>
                        <span>Drafts</span>
                        <strong data-counter="<%= events.filter(e => e.status === 'draft').length %>">0</strong>
                    </div>
                    <div class="kpi-tile kpi-tile--events">
                        <small>03</small>
                        <span>Total events</span>
                        <strong data-counter="<%= events.length %>">0</strong>
                    </div>
                    <div class="kpi-tile kpi-tile--bookings">
                        <small>04</small>
                        <span>Total bookings</span>
                        <strong data-counter="<%= totals.total_bookings || 0 %>">0</strong>
                    </div>
                    <div class="kpi-tile kpi-tile--revenue kpi-tile--full-width">
                        <div><small>05</small><span>Total confirmed revenue</span></div>
                        <strong data-counter="<%= (totals.total_revenue || 0).toFixed(2) %>" data-counter-decimals="2" data-counter-prefix="SGD $">SGD $0.00</strong>
                    </div>
                </div>
                </aside>

                <main class="dashboard-main">
                    <article class="organiser-control-dock">
                    <div class="organiser-control-copy">
                        <p class="eyebrow">Quick launch</p>
                        <h2>Organiser Controls</h2>
                        <p>Move straight into the task you need. Creating an event starts as a safe draft.</p>
                    </div>
                    <div class="organiser-action-grid">
                        <form action="/organiser/events/create-draft" method="POST">
                            <button type="submit" class="organiser-action organiser-action--primary"><span>01</span><strong>Create New Event</strong><i aria-hidden="true">↗</i></button>
                        </form>
                        <a href="/settings" class="organiser-action"><span>02</span><strong>Site Settings</strong><i aria-hidden="true">↗</i></a>
                        <a href="/organiser/booking-management" class="organiser-action"><span>03</span><strong>Booking Management</strong><i aria-hidden="true">↗</i></a>
                        <a href="/organiser/revenue" class="organiser-action"><span>04</span><strong>Revenue Dashboard</strong><i aria-hidden="true">↗</i></a>
                    </div>
                    </article>
                </main>
            </div>
        </div>
    </div>
</section>

<section class="section organiser-event-section organiser-event-section--published">
    <div class="container">
        <!-- Published Events Section -->
        <% const publishedEvents = events.filter(e => e.status === 'published'); %>
        <div class="section-head organiser-section-head">
            <div>
                <p class="eyebrow">Live catalogue</p>
                <h2 class="section-title">Published Events</h2>
                <p>Classes currently visible to attendees, with ticket and wishlist information.</p>
            </div>
            <span class="organiser-section-count"><strong><%= publishedEvents.length %></strong> live</span>
        </div>

        <% if (publishedEvents.length === 0) { %>
            <div class="empty-state">
                <p>No published events yet. Create and publish an event to get started.</p>
            </div>
        <% } else { %>
            <div class="event-grid">
                <% publishedEvents.forEach(function(event, index) { %>
                    <article class="event-card event-card--published organiser-event-card">
                        <% if (event.image_data) { %><div class="event-card-image event-card-image--uploaded"><img src="<%= event.image_data %>" alt="<%= event.title %>"></div><% } else { %><div class="event-card-image event-card-image--<%= index % 4 %>" aria-hidden="true"></div><% } %>
                        <span class="organiser-event-index"><%= String(index + 1).padStart(2, '0') %></span>
                        <div class="event-card-head">
                            <span class="status-badge status-badge--published">Published</span>
                            <span class="event-date"><%= formatDateDisplay(event.event_date) %></span>
                        </div>
                        <h3 class="event-card-title"><%= event.title %></h3>
                        <p class="event-card-desc"><%= event.description ? event.description.substring(0, 100) : 'No description yet.' %><%= event.description && event.description.length > 100 ? '...' : '' %></p>
                        
                        <div class="event-card-meta">
                            <% if (event.location) { %><span><strong>Location:</strong> <%= event.location %></span><% } %>
                            <% if (event.event_time) { %><span><strong>Time:</strong> <%= event.event_time %></span><% } %>
                        </div>

                        <div class="event-card-meta">
                            <% if (event.created_at) { %><span><strong>Created:</strong> <%= formatDateDisplay(event.created_at) %></span><% } %>
                            <% if (event.published_at) { %><span><strong>Published:</strong> <%= formatDateDisplay(event.published_at) %></span><% } %>
                        </div>

                        <div class="event-card-meta">
                            <% if (event.full_price_tickets > 0) { %><span><strong>Full Price Tickets:</strong> <%= event.full_price_tickets %> @ SGD $<%= event.full_price_cost.toFixed(2) %></span><% } %>
                            <% if (event.concession_tickets > 0) { %><span><strong>Concession Tickets:</strong> <%= event.concession_tickets %> @ SGD $<%= event.concession_cost.toFixed(2) %></span><% } %>
                        </div>

                        <div class="wishlist-interest" aria-label="Attendee wishlist interest">
                            <strong><%= Number(event.wishlist_count || 0) %></strong>
                            <span>wishlist <%= Number(event.wishlist_count || 0) === 1 ? 'save' : 'saves' %></span>
                        </div>

                        <div class="event-card-actions">
                            <a href="/attendee/events/<%= event.id %>" target="_blank" class="btn btn-sm btn-secondary">Attendee View ↗</a>
                            <a href="/organiser/events/<%= event.id %>/edit" class="btn btn-sm btn-ghost">Edit</a>
                            <form action="/organiser/events/<%= event.id %>/delete" method="POST" onsubmit="return confirm('Delete this event? This cannot be undone.');" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger-ghost">Delete</button>
                            </form>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </div>
</section>

<section class="section organiser-event-section organiser-event-section--scheduled">
    <div class="container">
        <!-- Scheduled Events Section -->
        <% const now = new Date(); %>
        <% const scheduledEvents = events.filter(e => e.status === 'draft' && e.scheduled_publish_at && new Date(e.scheduled_publish_at.replace(' ', 'T')) > now); %>

        <div class="section-head organiser-section-head">
            <div>
                <p class="eyebrow">Automation queue</p>
                <h2 class="section-title">Scheduled Events</h2>
                <p>Drafts waiting for their selected automatic publication time.</p>
            </div>
            <span class="organiser-section-count"><strong><%= scheduledEvents.length %></strong> queued</span>
        </div>

        <% if (scheduledEvents.length === 0) { %>
            <div class="empty-state">
                <p>No scheduled events right now. Schedule a draft to publish it automatically later.</p>
            </div>
        <% } else { %>
            <div class="event-grid">
                <% scheduledEvents.forEach(function(event, index) { %>
                    <article class="event-card event-card--draft organiser-event-card">
                        <% if (event.image_data) { %><div class="event-card-image event-card-image--uploaded"><img src="<%= event.image_data %>" alt="<%= event.title %>"></div><% } else { %><div class="event-card-image event-card-image--<%= (index + 1) % 4 %>" aria-hidden="true"></div><% } %>
                        <span class="organiser-event-index"><%= String(index + 1).padStart(2, '0') %></span>
                        <div class="event-card-head">
                            <span class="status-badge status-badge--draft">Scheduled</span>
                            <span class="event-date"><%= formatDateDisplay(event.event_date) %></span>
                        </div>
                        <h3 class="event-card-title"><%= event.title %></h3>
                        <p class="event-card-desc"><%= event.description ? event.description.substring(0, 100) : 'No description yet.' %><%= event.description && event.description.length > 100 ? '...' : '' %></p>

                        <div class="event-card-meta">
                            <% if (event.location) { %><span><strong>Location:</strong> <%= event.location %></span><% } %>
                            <% if (event.event_time) { %><span><strong>Time:</strong> <%= event.event_time %></span><% } %>
                        </div>

                        <div class="event-card-meta">
                            <span><strong>Publish scheduled:</strong> <%= formatDateTimeDisplay(event.scheduled_publish_at) %></span>
                        </div>

                        <div class="event-card-meta">
                            <% if (event.full_price_tickets > 0) { %><span><strong>Full Price Tickets:</strong> <%= event.full_price_tickets %> @ $<%= event.full_price_cost.toFixed(2) %></span><% } %>
                            <% if (event.concession_tickets > 0) { %><span><strong>Concession Tickets:</strong> <%= event.concession_tickets %> @ $<%= event.concession_cost.toFixed(2) %></span><% } %>
                        </div>

                        <div class="event-card-actions">
                            <a href="/organiser/events/<%= event.id %>/edit" class="btn btn-sm btn-ghost">Edit</a>
                            <form action="/organiser/events/<%= event.id %>/publish" method="POST" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-primary">Publish Now</button>
                            </form>
                            <form action="/organiser/events/<%= event.id %>/delete" method="POST" onsubmit="return confirm('Delete this scheduled event? This cannot be undone.');" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger-ghost">Delete</button>
                            </form>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </div>
</section>

<section class="section organiser-event-section organiser-event-section--drafts">
    <div class="container">
        <!-- Draft Events Section -->
        <% const draftEvents = events.filter(e => e.status === 'draft' && !scheduledEvents.some(scheduled => scheduled.id === e.id)); %>
        <div class="section-head organiser-section-head">
            <div>
                <p class="eyebrow">Work in progress</p>
                <h2 class="section-title">Draft Events</h2>
                <p>Private working copies. Review every required field before publishing.</p>
            </div>
            <div class="organiser-section-actions">
                <span class="organiser-section-count"><strong><%= draftEvents.length %></strong> drafts</span>
                <form action="/organiser/events/create-draft" method="POST">
                    <button type="submit" class="btn btn-primary">+ New Draft</button>
                </form>
            </div>
        </div>
        <% if (draftEvents.length === 0) { %>
            <div class="empty-state">
                <div class="empty-icon">
                    <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="16" rx="2"/>
                        <path d="M3 9h18"/>
                    </svg>
                </div>
                <h3>No draft events yet</h3>
                <p>Create a new draft event to get started.</p>
                <form action="/organiser/events/create-draft" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-primary">Create Draft Event</button>
                </form>
            </div>
        <% } else { %>
            <div class="event-grid">
                <% draftEvents.forEach(function(event, index) { %>
                    <article class="event-card event-card--draft organiser-event-card">
                        <% if (event.image_data) { %><div class="event-card-image event-card-image--uploaded"><img src="<%= event.image_data %>" alt="<%= event.title %>"></div><% } else { %><div class="event-card-image event-card-image--<%= (index + 2) % 4 %>" aria-hidden="true"></div><% } %>
                        <span class="organiser-event-index"><%= String(index + 1).padStart(2, '0') %></span>
                        <div class="event-card-head">
                            <span class="status-badge status-badge--draft">Draft</span>
                            <span class="event-date"><%= formatDateDisplay(event.event_date) %></span>
                        </div>
                        <h3 class="event-card-title"><%= event.title %></h3>
                        <p class="event-card-desc"><%= event.description ? event.description.substring(0, 100) : 'No description yet.' %><%= event.description && event.description.length > 100 ? '...' : '' %></p>
                        
                        <div class="event-card-meta">
                            <% if (event.location) { %><span><strong>Location:</strong> <%= event.location %></span><% } %>
                            <% if (event.event_time) { %><span><strong>Time:</strong> <%= event.event_time %></span><% } %>
                        </div>

                        <div class="event-card-meta">
                            <% if (event.created_at) { %><span><strong>Created:</strong> <%= formatDateDisplay(event.created_at) %></span><% } %>
                        </div>

                        <div class="event-card-meta">
                            <% if (event.full_price_tickets > 0) { %><span><strong>Full Price Tickets:</strong> <%= event.full_price_tickets %> @ SGD $<%= event.full_price_cost.toFixed(2) %></span><% } %>
                            <% if (event.concession_tickets > 0) { %><span><strong>Concession Tickets:</strong> <%= event.concession_tickets %> @ SGD $<%= event.concession_cost.toFixed(2) %></span><% } %>
                        </div>

                        <div class="event-card-actions">
                            <a href="/organiser/events/<%= event.id %>/edit" class="btn btn-sm btn-ghost">Edit</a>
                            <form action="/organiser/events/<%= event.id %>/publish" method="POST" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-primary">Publish</button>
                            </form>
                            <form action="/organiser/events/<%= event.id %>/delete" method="POST" onsubmit="return confirm('Delete this event? This cannot be undone.');" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger-ghost">Delete</button>
                            </form>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </div>
</section>

<%- include('footer') %>
