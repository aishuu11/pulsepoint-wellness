<%- include('head') %>
<body>
<%- include('nav') %>

<section class="page-header">
    <div class="container">
        <p class="eyebrow">Organiser Access</p>
        <h1 class="page-title">Organiser Login</h1>
        <p class="page-lead">Sign in with your organiser credentials to manage events.</p>
        <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="form-card form-card--narrow">
            <form action="/organiser/login" method="POST">
                <div class="field">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" placeholder="organiser@example.com" required>
                </div>
                <div class="field">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" placeholder="EventFlow123!" required>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Sign In</button>
                </div>
            </form>
        </div>
    </div>
</section>

<%- include('footer') %>
