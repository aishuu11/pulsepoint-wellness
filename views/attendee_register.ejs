<%- include('head') %>
<body>
<%- include('nav') %>

<section class="page-header">
    <div class="container">
        <p class="eyebrow">Attendee Access</p>
        <h1 class="page-title">Create your attendee account</h1>
        <p class="page-lead">Register once and enjoy a personal attendee experience.</p>
        <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="form-card form-card--narrow">
            <form action="/attendee/register" method="POST">
                <div class="field">
                    <label for="name">Full Name</label>
                    <input type="text" id="name" name="name" placeholder="Jane Doe" required>
                </div>
                <div class="field">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" placeholder="you@example.com" required>
                </div>
                <div class="field">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" placeholder="Choose a password" required>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-block">Create Account</button>
                </div>
            </form>
            <p class="helper-text">Already have an account? <a href="/attendee/login">Sign in instead</a>.</p>
        </div>
    </div>
</section>

<%- include('footer') %>
