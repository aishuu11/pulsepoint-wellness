<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> &middot; <%= locals.siteSettings ? siteSettings.name : 'PulsePoint Wellness' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,500;0,600;0,700;0,800;0,900;1,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --site-display-font: <%= siteSettings && siteSettings.display_font_family ? `'${siteSettings.display_font_family}'` : "'Barlow Condensed'" %>;
            --site-description-style: <%= siteSettings && siteSettings.description_italic ? 'italic' : 'normal' %>;
        }
    </style>
    <link rel="stylesheet" href="/css/styles.css">
</head>
