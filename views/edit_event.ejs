<%- include('head') %>
<body>
<%- include('nav') %>

<section class="page-header">
    <div class="container">
        <p class="eyebrow">Editing</p>
        <h1 class="page-title">Organiser Edit Event Page</h1>
        <p class="page-lead">
            <span class="status-badge status-badge--<%= event.status %>"><%= event.status %></span>
            Created <%= formatDateDisplay(event.created_at) %> | Last modified <%= formatDateTimeDisplay(event.last_modified_at) %>
        </p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="edit-layout">
            <div class="edit-main">
                <form id="event-edit-form" action="/organiser/events/<%= event.id %>/update" method="POST" class="form-card event-form">
                    <% if (typeof validationErrors !== 'undefined' && validationErrors.length > 0) { %>
                        <div class="alert alert--error" role="alert">
                            <strong>Please correct the following:</strong>
                            <ul>
                                <% validationErrors.forEach(function(error) { %><li><%= error %></li><% }) %>
                            </ul>
                        </div>
                    <% } %>
                    <div class="form-card-header">
                        <div>
                            <h2 class="form-card-title">Event Details</h2>
                        </div>
                    </div>

                    <div class="field">
                        <label for="title">Title</label>
                        <input type="text" id="title" name="title" value="<%= event.title %>" required>
                    </div>

                    <div class="field">
                        <label for="description">Description</label>
                        <textarea id="description" name="description" rows="5"><%= event.description %></textarea>
                    </div>

                    <div class="field image-uploader" data-image-uploader>
                        <label for="event_image_file">Event photo <span class="optional-label">(optional)</span></label>
                        <div class="event-image-preview <%= event.image_data ? 'has-image' : '' %>" data-image-preview-wrap>
                            <img src="<%= event.image_data || '' %>" alt="Event photo preview" data-image-preview <%= event.image_data ? '' : 'hidden' %>>
                            <span data-image-placeholder <%= event.image_data ? 'hidden' : '' %>>Add a class photo to make the attendee listing more engaging.</span>
                        </div>
                        <input type="file" id="event_image_file" accept="image/jpeg,image/png,image/webp" data-image-input>
                        <input type="hidden" name="image_data" value="" data-image-data>
                        <p class="field-note">JPG, PNG or WEBP, up to 2 MB. The photo is optional.</p>
                        <p class="field-note image-upload-error" data-image-error aria-live="polite"></p>
                        <% if (event.image_data) { %>
                            <label class="checkbox-row image-remove-option">
                                <input type="checkbox" name="remove_image" value="1"> Remove the current photo
                            </label>
                        <% } %>
                    </div>

                    <div class="field-row">
                        <div class="field">
                            <label for="event_date">Date</label>
                            <input type="date" id="event_date" name="event_date" value="<%= event.event_date %>">
                        </div>
                        <div class="field">
                            <label for="event_time">Time</label>
                            <input type="time" id="event_time" name="event_time" value="<%= event.event_time %>">
                        </div>
                    </div>

                    <div class="field">
                        <label for="scheduled_publish_at">Schedule publish</label>
                        <input type="datetime-local" id="scheduled_publish_at" name="scheduled_publish_at"
                            value="<%= event.scheduled_publish_at ? event.scheduled_publish_at.replace(' ', 'T').slice(0,16) : '' %>">
                        <p class="field-note">Choose a future date and time to publish this draft automatically.</p>
                    </div>

                    <div class="field">
                        <label for="booking_deadline">Booking deadline <span class="optional-label">(optional)</span></label>
                        <input type="datetime-local" id="booking_deadline" name="booking_deadline"
                            value="<%= event.booking_deadline ? event.booking_deadline.replace(' ', 'T').slice(0,16) : '' %>">
                        <p class="field-note">Must be in the future and before the session starts. Leave blank to accept bookings until the start time.</p>
                    </div>

                    <div class="field-row">
                        <div class="field">
                            <label for="duration_minutes">Duration (minutes)</label>
                            <input type="number" id="duration_minutes" name="duration_minutes" min="0" value="<%= event.duration_minutes || 0 %>">
                        </div>
                    </div>

                    <div class="field">
                        <label for="location">Location</label>
                        <input type="text" id="location" name="location" value="<%= event.location %>" placeholder="Studio name or address">
                    </div>

                    <h2 class="form-card-title" style="margin-top:2.5rem">Tickets &amp; Pricing</h2>

                    <div class="ticket-grid">
                        <div class="ticket-block">
                            <h3 class="ticket-block-title">Full Price</h3>
                            <div class="field">
                                <label for="full_price_tickets">Tickets available</label>
                                <input type="number" id="full_price_tickets" name="full_price_tickets" min="0" value="<%= event.full_price_tickets %>">
                            </div>
                            <div class="field">
                                <label for="full_price_cost">Price per ticket (SGD)</label>
                                <input type="number" id="full_price_cost" name="full_price_cost" min="0" step="0.01" value="<%= event.full_price_cost %>">
                            </div>
                            <p class="ticket-booked"><%= bookings.full_price_booked %> booked so far</p>
                        </div>

                        <div class="ticket-block">
                            <h3 class="ticket-block-title">Concession</h3>
                            <div class="field">
                                <label for="concession_tickets">Tickets available</label>
                                <input type="number" id="concession_tickets" name="concession_tickets" min="0" value="<%= event.concession_tickets %>">
                            </div>
                            <div class="field">
                                <label for="concession_cost">Price per ticket (SGD)</label>
                                <input type="number" id="concession_cost" name="concession_cost" min="0" step="0.01" value="<%= event.concession_cost %>">
                            </div>
                            <p class="ticket-booked"><%= bookings.concession_booked %> booked so far</p>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" name="action" value="save" class="btn btn-primary">Save Changes</button>
                        <a href="/organiser" class="btn btn-ghost">Back to Organiser Home Page</a>
                    </div>
                </form>
            </div>

            <aside class="edit-side">
                <div class="side-card">
                    <h3 class="side-card-title">Publish</h3>
                    <p class="side-card-text">
                        <% if (event.status === 'draft') { %>
                            This event is a draft. Publish it to make it visible to attendees.
                        <% } else { %>
                            This event is live and visible to attendees.
                        <% } %>
                    </p>
                    <% if (event.status === 'draft') { %>
                        <% if (event.scheduled_publish_at) { %>
                            <p class="side-card-text">Scheduled to publish at <%= formatDateTimeDisplay(event.scheduled_publish_at) %>.</p>
                        <% } %>
                        <button type="submit" form="event-edit-form" name="action" value="publish" class="btn btn-primary btn-block">Save &amp; Publish Event</button>
                        <p class="field-note">Your current edits are saved before publication.</p>
                    <% } else { %>
                        <p class="published-at">Published <%= formatDateDisplay(event.published_at) %></p>
                    <% } %>
                </div>

                <div class="side-card side-card--danger">
                    <h3 class="side-card-title">Remove Event</h3>
                    <p class="side-card-text">Permanently delete this event and all its bookings.</p>
                    <form action="/organiser/events/<%= event.id %>/delete" method="POST" onsubmit="return confirm('Delete this event? This cannot be undone.');">
                        <button type="submit" class="btn btn-danger-ghost btn-block">Delete Event</button>
                    </form>
                </div>
            </aside>
        </div>
    </div>
</section>

<%- include('footer') %>
